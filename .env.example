# ============================================================
# Tutor-SIG — Configuración del proveedor de IA (SOLO SERVIDOR)
# La selección de proveedor y modelos se realiza ÚNICAMENTE
# mediante estas variables de entorno. Ninguna clave llega
# al navegador: el frontend solo habla con /api/* a través de
# src/services/aiService.ts.
# ============================================================

# Proveedor activo: openrouter | deepseek | gemini | claude | ollama
MODEL_PROVIDER=openrouter

# ---- OpenRouter (PROVEEDOR PRIORITARIO) ---------------------
# Obtén tu clave en https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# URL base opcional (por defecto https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ---- Modelos (solo por entorno; el frontend nunca los envía) ----
# Modelo principal (default: DeepSeek Flash a través de OpenRouter)
DEFAULT_MODEL=deepseek/deepseek-v4-flash
# Cadena de fallback en orden de prioridad (429/503/402/timeout → siguiente).
# El último modelo es gratuito (:free): solo se usa si los pagos fallan
# (p. ej. cuenta sin créditos) — puedes quitarlo cuando tengas saldo.
FALLBACK_MODELS=qwen/qwen3.6-flash,anthropic/claude-sonnet-4.6,minimax/minimax-m3:free

# ---- Proveedores directos opcionales -------------------------
# DeepSeek directo (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Gemini (compatibilidad — AI Studio inyecta esta clave como secreto)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Claude / Anthropic (preparado para integración)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# Ollama local (preparado para integración)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Ajustes generales ----------------------------------------
# Tiempo máximo por petición a un modelo (ms)
# AI_REQUEST_TIMEOUT_MS=120000
# Número de ciclos completos sobre el pool de modelos
# AI_FALLBACK_CYCLES=2
# URL pública de la aplicación (referer de OpenRouter y enlaces)
APP_URL="MY_APP_URL"

# ---- Identidad institucional (multi-institución) -------------
# La interfaz, el footer, la bienvenida y el prompt del tutor toman
# estos valores del servidor (/api/config). Por defecto: CESMAG.
# Ejemplo para la versión de la Universidad Mariana:
# TUTOR_SIG_INSTITUTION="Universidad Mariana"
# TUTOR_SIG_AUTHOR="Geógr. Dany Benavides Bolaños"
# TUTOR_SIG_PORTAL_URL="https://www.umariana.edu.co/"
# TUTOR_SIG_NAME="Tutor-SIG"
